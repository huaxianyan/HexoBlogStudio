<Window x:Class="HexoBlogStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hexo 博客工作台" Height="820" Width="1360"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="13">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="PreviewButton" Style="{StaticResource ToolButton}" Content="本地预览" Click="OnPreviewClick"
                        ToolTip="启动 hexo server，端口 4000" />
                <Button x:Name="StopButton" Style="{StaticResource ToolButton}" Content="停止" Click="OnStopClick"
                        ToolTip="结束后台运行的本地预览" />
                <Button x:Name="OpenSiteButton" Style="{StaticResource ToolButton}" Content="打开站点" Click="OnOpenSiteClick" />
                <Separator Margin="6,0" />
                <Button x:Name="BuildButton" Style="{StaticResource ToolButton}" Content="构建" Click="OnBuildClick"
                        ToolTip="执行 hexo generate，产物在 public 目录" />
                <Button x:Name="PublishButton" Style="{StaticResource ToolButton}" Content="发布" Click="OnPublishClick"
                        ToolTip="提交改动并推送到 GitHub，触发线上更新" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock x:Name="SitePathText" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="#666666" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                <Button Style="{StaticResource ToolButton}" Content="更换站点目录" Click="OnChooseSiteClick" />
            </StackPanel>
        </DockPanel>

        <!-- 三栏主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="330" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- 文章列表 -->
            <DockPanel Grid.Column="0" Margin="0,0,4,0">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,6"
                         ToolTip="按标题、标签或文件名筛选" TextChanged="OnSearchChanged" />
                <TextBlock x:Name="PostCountText" DockPanel.Dock="Bottom" Margin="2,6,0,0"
                           Foreground="#888888" FontSize="12" />
                <ListBox x:Name="PostList" DisplayMemberPath="ListLabel"
                         SelectionChanged="OnPostSelected"
                         HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>

            <!-- 编辑器 -->
            <DockPanel Grid.Column="2" Margin="4,0,4,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button x:Name="SaveButton" Style="{StaticResource ToolButton}" Content="保存" Click="OnSaveClick"
                                ToolTip="Ctrl+S" />
                        <Button x:Name="OpenExternalButton" Style="{StaticResource ToolButton}" Content="用其他软件打开"
                                Click="OnOpenExternalClick" />
                        <Button x:Name="RevealButton" Style="{StaticResource ToolButton}" Content="在资源管理器中显示"
                                Click="OnRevealClick" />
                    </StackPanel>
                    <TextBlock x:Name="EditorStateText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="#888888" FontSize="12" />
                </DockPanel>
                <TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas, monospace" FontSize="13"
                         IsEnabled="False" TextChanged="OnEditorTextChanged"
                         PreviewKeyDown="OnEditorKeyDown" />
            </DockPanel>

            <!-- 图片工作区 -->
            <DockPanel Grid.Column="4" Margin="4,0,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock x:Name="ImagesHeaderText" Text="图片工作区" DockPanel.Dock="Left"
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Button x:Name="OpenImageFolderButton" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Style="{StaticResource ToolButton}" Content="打开文件夹" Click="OnOpenImageFolderClick"
                            IsEnabled="False" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Background="#FAFAFA">
                    <ItemsControl x:Name="ImageList" Margin="4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="150" Margin="4" Background="White" BorderBrush="#E5E5E5"
                                        BorderThickness="1" CornerRadius="3" ToolTip="{Binding Path}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="打开图片" Click="OnOpenImageClick" />
                                            <MenuItem Header="在资源管理器中显示" Click="OnRevealImageClick" />
                                            <Separator />
                                            <MenuItem Header="插入到正文" Click="OnInsertImageClick" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <Grid Height="110" Background="#F2F2F2">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4"
                                                   MouseLeftButtonUp="OnImageThumbClick" Cursor="Hand" />
                                            <TextBlock Text="{Binding Placeholder}" Foreground="#999999"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="11" />
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Margin="5,4"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- 日志 -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="输出" DockPanel.Dock="Left" Foreground="#666666" />
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource ToolButton}"
                        Content="清空" Click="OnClearLogClick" />
            </DockPanel>
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                     Background="#1E1E1E" Foreground="#DDDDDD" BorderThickness="0" Padding="6" />
        </DockPanel>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="3" Margin="0,6,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
