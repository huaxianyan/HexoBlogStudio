<ui:FluentWindow x:Class="HexoBlogStudio.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Hexo 博客工作台"
                 Height="880" Width="1440" MinHeight="620" MinWidth="1040"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="Microsoft YaHei UI, Segoe UI, SimSun" FontSize="13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Hexo 博客工作台" />

        <!-- 工具栏 -->
        <ui:Card Grid.Row="1" Margin="14,2,14,10" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <ui:Button x:Name="PreviewButton" Appearance="Primary"
                               Icon="{ui:SymbolIcon Play24}" Content="启动本地预览"
                               Click="OnPreviewToggleClick" MinWidth="130" Margin="0,0,8,0" />
                    <ui:Button x:Name="OpenSiteButton" Icon="{ui:SymbolIcon Globe24}" Content="打开站点"
                               Click="OnOpenSiteClick" Margin="0,0,8,0" IsEnabled="False" />
                    <ui:Button x:Name="BuildButton" Icon="{ui:SymbolIcon ArrowSync24}" Content="构建"
                               Click="OnBuildClick" Margin="0,0,8,0" />
                    <ui:Button x:Name="PublishButton" Icon="{ui:SymbolIcon CloudArrowUp24}" Content="发布"
                               Click="OnPublishClick" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="SitePathText" Style="{StaticResource MutedText}"
                               Margin="0,0,10,0" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                    <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Content="更换目录" Click="OnChooseSiteClick" />
                </StackPanel>
            </DockPanel>
        </ui:Card>

        <!-- 三栏 -->
        <Grid Grid.Row="2" Margin="14,0,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="210" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="340" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="340" MinWidth="250" />
            </Grid.ColumnDefinitions>

            <!-- 文章列表 -->
            <ui:Card Grid.Column="0" Padding="10">
                <DockPanel>
                    <ui:TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                                PlaceholderText="搜索标题、标签或文件名"
                                Icon="{ui:SymbolIcon Search24}" TextChanged="OnSearchChanged" />
                    <TextBlock x:Name="PostCountText" DockPanel.Dock="Bottom" Style="{StaticResource MutedText}"
                               Margin="2,8,0,0" />
                    <ListBox x:Name="PostList" DisplayMemberPath="ListLabel"
                             SelectionChanged="OnPostSelected"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="Margin" Value="0,0,0,1" />
                                <Setter Property="FontSize" Value="12.5" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </ui:Card>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- 编辑器 -->
            <ui:Card Grid.Column="2" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <ui:Button x:Name="SaveButton" Icon="{ui:SymbolIcon Save24}" Content="保存"
                                       Click="OnSaveClick" Margin="0,0,8,0" ToolTip="Ctrl+S" />
                            <ui:Button x:Name="OpenExternalButton" Icon="{ui:SymbolIcon DocumentText24}"
                                       Content="用其他软件打开" Click="OnOpenExternalClick" Margin="0,0,8,0" />
                            <ui:Button x:Name="RevealButton" Icon="{ui:SymbolIcon FolderOpen24}"
                                       Content="在资源管理器中显示" Click="OnRevealClick" />
                        </StackPanel>
                        <TextBlock x:Name="EditorStateText" DockPanel.Dock="Right"
                                   HorizontalAlignment="Right" Style="{StaticResource MutedText}" />
                    </DockPanel>
                    <TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI, SimSun" FontSize="13"
                             IsEnabled="False" TextChanged="OnEditorTextChanged"
                             PreviewKeyDown="OnEditorKeyDown" />
                </DockPanel>
            </ui:Card>

            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- 图片工作区 -->
            <ui:Card Grid.Column="4" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock x:Name="ImagesHeaderText" Style="{StaticResource PaneHeaderText}" Text="图片工作区" />
                        <ui:Button x:Name="OpenImageFolderButton" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   Icon="{ui:SymbolIcon Folder24}" Content="打开文件夹"
                                   Click="OnOpenImageFolderClick" IsEnabled="False" />
                    </DockPanel>
                    <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ImageList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="152" Margin="0,0,8,8" CornerRadius="6" Padding="6"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1" ToolTip="{Binding Path}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="打开图片" Click="OnOpenImageClick" />
                                                <MenuItem Header="在资源管理器中显示" Click="OnRevealImageClick" />
                                                <Separator />
                                                <MenuItem Header="插入到正文" Click="OnInsertImageClick" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel>
                                            <Border Height="112" CornerRadius="4" ClipToBounds="True"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                           MouseLeftButtonUp="OnImageThumbClick" Cursor="Hand" />
                                                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18"
                                                                     Visibility="{Binding LoadingVisibility}" />
                                                    <TextBlock Text="{Binding Placeholder}" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding PlaceholderVisibility}" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="11" Margin="2,6,2,0"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                        <TextBlock x:Name="ImageEmptyHint" Text="这篇没有配图" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Style="{StaticResource MutedText}" />
                    </Grid>
                </DockPanel>
            </ui:Card>
        </Grid>

        <!-- 输出 -->
        <ui:Card Grid.Row="3" Margin="14,0,14,0" Padding="10,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="输出" Style="{StaticResource PaneHeaderText}" />
                <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right" Icon="{ui:SymbolIcon Broom24}"
                           Content="清空" Click="OnClearLogClick" />
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Margin="0,0,12,0"
                           HorizontalAlignment="Right" Style="{StaticResource MutedText}" Text="就绪" />
            </DockPanel>
        </ui:Card>

        <Border Grid.Row="4" Margin="14,6,14,14" Height="160" CornerRadius="8"
                Background="{StaticResource LogBackgroundBrush}">
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI, SimSun" FontSize="12"
                     Background="Transparent" Foreground="{StaticResource LogForegroundBrush}"
                     BorderThickness="0" Padding="10" />
        </Border>
    </Grid>
</ui:FluentWindow>
