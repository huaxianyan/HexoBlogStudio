<ui:FluentWindow x:Class="HexoBlogStudio.CommitMessageDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="发布"
                 Width="560" Height="300" ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ShowInTaskbar="False"
                 FontFamily="Microsoft YaHei UI, Segoe UI, SimSun" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="发布" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="18,8,18,0">
            <TextBlock Text="这次改了什么？推送后会触发线上更新。"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10" />
            <ui:TextBox x:Name="MessageInput" AcceptsReturn="True" TextWrapping="Wrap" Height="120"
                        VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,0,18,16">
            <ui:Button Content="取消" MinWidth="88" IsCancel="True" Margin="0,0,8,0" />
            <ui:Button Content="发布" MinWidth="88" Appearance="Primary" IsDefault="True" Click="OnConfirmClick" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
